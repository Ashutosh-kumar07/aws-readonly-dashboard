{
  "name": "aws-readonly-dashboard",
  "version": "1.1.0",
  "description": "Local, strictly read-only AWS dashboard for cost, security, CloudWatch, CloudTrail and Compute Optimizer insights, with optional user-triggered AI analysis.",
  "keywords": [
    "aws",
    "dashboard",
    "cli",
    "cost-explorer",
    "billing",
    "finops",
    "security",
    "cloudtrail",
    "cloudwatch",
    "compute-optimizer",
    "read-only",
    "devops",
    "sre",
    "gemini",
    "ai"
  ],
  "license": "MIT",
  "author": "aws-readonly-dashboard contributors",
  "homepage": "https://github.com/Ashutosh-kumar07/aws-readonly-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashutosh-kumar07/aws-readonly-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/Ashutosh-kumar07/aws-readonly-dashboard/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aws-readonly-dashboard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "^3.1134.0",
    "@aws-sdk/client-cloudtrail": "^3.1134.0",
    "@aws-sdk/client-cloudwatch": "^3.1134.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1134.0",
    "@aws-sdk/client-compute-optimizer": "^3.1134.0",
    "@aws-sdk/client-config-service": "^3.1134.0",
    "@aws-sdk/client-cost-explorer": "^3.1134.0",
    "@aws-sdk/client-ec2": "^3.1134.0",
    "@aws-sdk/client-guardduty": "^3.1134.0",
    "@aws-sdk/client-iam": "^3.1134.0",
    "@aws-sdk/client-inspector2": "^3.1134.0",
    "@aws-sdk/client-lambda": "^3.1134.0",
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/client-s3-control": "^3.1134.0",
    "@aws-sdk/client-securityhub": "^3.1134.0",
    "@aws-sdk/client-sts": "^3.1134.0",
    "@aws-sdk/client-support": "^3.1134.0",
    "@aws-sdk/credential-providers": "^3.1134.0",
    "@smithy/shared-ini-file-loader": "^3.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
